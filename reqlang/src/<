// TODO: Avoid boxed set, limit the number of nested sets
#[derive(PartialEq, Eq, Debug, Clone)]
pub enum TypeKind {
    Number,
    Boolean,
    Undefined,
    Set(Box<TypeKind>),
}

impl Display for TypeKind {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{:?}", self)
    }
}

impl TypeKind {
    pub fn is_set(&self) -> bool {
        match self {
            TypeKind::Set(_) => true,
            _ => false,
        }
    }
}

#[derive(Eq, PartialEq, Debug, Clone, thiserror::Error)]
pub enum Issue {
    #[error("previously caught error")]
    Poison,
    #[error("expected a set got {0}")]
    NotASet(TypeKind),
    #[error("expected {0} got {1}")]
    UnexpectedType(TypeKind, TypeKind),
    #[error("cannot retrieve the domain for this identifier")]
    DomainNotFound,
}

impl From<&Issue> for Severity {
    fn from(_: &Issue) -> Self {
        use Severity::*;

        Critical
    }
}

pub type Node = link::expression::Node<super::TypeResult>;

// TODO: Circular references between domains and requirements can loop indefinitely
pub(super) fn evaluate<N, E, M>(
    entities: &[link::entity::Node<N, E, M>],
    arena: &[link::expression::Node<E>],
    entity: node::entity::Idx,
    types: &mut Vec<Vec<Option<TypeResult>>>,
    idx: Option<Range<usize>>,
) {
    use node::entity::Variant::*;
    use node::expression::Variant::*;

    let arena = match idx {
        Some(rng) => &arena[rng],
        None => arena,
    };

    let local = &mut types[usize::from(entity)];
    for node in arena {
        if let Identifier(ident) = node.variant {
            match tgt {
                Ok(Target::Entity(tgt)) if types[usize::from(tgt)].is_empty() => {
                    evaluate(entities, arena, tgt, types, None);
                    continue;
                }
                Ok(Target::Expression(_, domain)) if local[usize::from(domain)].is_none() => {
                    let len = count(arena, domain);
                    let start = usize::from(domain);
                    let end = start + len;
                    evaluate(entities, arena, entity, types, Some(start..end));
                    continue;
                }

                _ => {}
            }
        }
    }
}

pub fn count<P>(arena: &[link::expression::Node<P>], idx: Idx) -> usize {
    let node = &arena[usize::from(idx)];
    1 + node.variant.children_iter().map(|c| count(arena, c)).sum()
}
