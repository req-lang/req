root = _{ SOI ~ expr ~ EOI }

expr = { prefix* ~ primary ~ postfix* ~ (infix ~ prefix* ~ primary ~ postfix*)* }

infix = _{ add | sub | mul | pow | rem | and | or | xor | ge | le | neq | gt | lt | ini | fix | eq | div | uni | inter | incl | implies | since | iff | ins | diff | comp | tol }
add   =  { "+" }
sub   =  { "-" }
mul   =  { "*" }
div   =  { "/" }
rem   =  { "%" }
pow   =  { "^" }

and     = @{ "and" ~ !WORD_CHAR }
or      = @{ "or" ~ !WORD_CHAR }
xor     = @{ "xor" ~ !WORD_CHAR }
implies = @{ "implies" ~ !WORD_CHAR }
iff     = @{ "iff" ~ !WORD_CHAR }

ins = @{ "in" ~ !WORD_CHAR }
tol = @{ "tol" ~ !WORD_CHAR }

gt  = { ">" }
lt  = { "<" }
ge  = { ">=" }
le  = { "<=" }
neq = { "<>" }
eq  = { "=" }
fix = { ":=" }
ini = { "°=" }

uni   = @{ "union" ~ !WORD_CHAR }
inter = @{ "intersection" ~ !WORD_CHAR }
diff  = @{ "difference" ~ !WORD_CHAR }
comp  = @{ "complement" ~ !WORD_CHAR }
incl  = @{ "includes" ~ !WORD_CHAR }

since = @{ "since" ~ !WORD_CHAR }

prefix = _{ neg | plus | not | rise | fall | event | always | previous }
neg    =  { "-" }
plus   =  { "+" }

not = @{ "not" ~ !WORD_CHAR }

previous = @{ "previously" ~ !WORD_CHAR }
rise     = @{ "rising" ~ !WORD_CHAR }
fall     = @{ "falling" ~ !WORD_CHAR }
event    = @{ "eventually" ~ !WORD_CHAR }
always   = @{ "always" ~ !WORD_CHAR }

postfix = _{ fac | call }
fac     =  { "!" }
call    =  { "(" ~ expr? ~ ("," ~ expr)* ~ ")" }

primary = _{
    (num | bool | undefined | set | rng | intv | branch | when | aggregation | ident | "(" ~ expr ~ ")")
}

branch =  { if ~ expr ~ then ~ expr ~ (else ~ expr)? ~ end }
if     = @{ "if" ~ !WORD_CHAR }
else   = @{ "else" ~ !WORD_CHAR }

when      =  { whe ~ ((case ~ ("," ~ case)? ~ "," ~ otherwise) | (case ~ ",")* ~ case) ~ end }
whe       = @{ "when" ~ !WORD_CHAR }
case      =  { expr ~ then ~ expr }
otherwise =  { other ~ expr }

such_that = _{ such ~ that ~ expr }

aggregation =  { aggregator ~ expr ~ (binding | ("," ~ expr)*) ~ end }
aggregator  = _{ (all | any | max | min | argmax | argmin | sup | inf | sum | prod | count | uni | inter | one | choose) }
all         = @{ "all" ~ !WORD_CHAR }
any         = @{ "any" ~ !WORD_CHAR }
one         = @{ "one" ~ !WORD_CHAR }
max         = @{ "max" ~ !WORD_CHAR }
min         = @{ "min" ~ !WORD_CHAR }
sum         = @{ "sum" ~ !WORD_CHAR }
prod        = @{ "prod" ~ !WORD_CHAR }
argmax      = @{ "argmax" ~ !WORD_CHAR }
argmin      = @{ "argmin" ~ !WORD_CHAR }
sup         = @{ "sup" ~ !WORD_CHAR }
inf         = @{ "inf" ~ !WORD_CHAR }
count       = @{ "count" ~ !WORD_CHAR }
choose      = @{ "choose" ~ !WORD_CHAR }

then = @{ "then" ~ !WORD_CHAR }
end  = @{ "end" ~ !WORD_CHAR }
such = @{ "such" ~ !WORD_CHAR }
that = @{ "that" ~ !WORD_CHAR }
in   = @{ "in" ~ !WORD_CHAR }

set        =  { "{" ~ expr ~ (binding | ("," ~ expr)*) ~ "}" }
binding    =  { for ~ label ~ in ~ expr ~ such_that? }
for        = @{ "for" ~ !WORD_CHAR }
intv       =  { bracket ~ expr ~ "," ~ expr ~ bracket }
bracket    = _{ lbrkt | rbrkt }
rng        =  { "[[" ~ expr ~ "," ~ expr ~ "]]" }
lbrkt      =  { "[" }
rbrkt      =  { "]" }
bool       =  { tru | fals }
tru        = @{ "true" ~ !WORD_CHAR }
fals       = @{ "false" ~ !WORD_CHAR }
undefined  = @{ "undefined" ~ !WORD_CHAR }
other      = @{ "otherwise" ~ !WORD_CHAR }
num        =  { real | infinity | int }
real       = @{ int ~ ("." ~ ASCII_DIGIT*)? ~ (^"e" ~ int)? }
int        =  { ASCII_DIGIT+ }
infinity   = @{ "infinity" ~ !WORD_CHAR }
ident      = @{ (label ~ "::")* ~ label }
label      = @{ !keyword ~ word }
word       = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHA | ASCII_DIGIT | "_")* }
WHITESPACE = _{ " " | "\t" | NEWLINE }

// Keywords are atomic tokens, a keyword never matches the start of a longer word:
// `notable` is one identifier, not `not` followed by `able`. They appear in the
// parse tree, the parser skips them.
WORD_CHAR = _{ ASCII_ALPHANUMERIC | "_" }

// Keywords are reserved and cannot be used as a label, except for aggregators:
// they only appear at the start of an expression and need an `end`.
keyword = _{ and | or | xor | implies | iff | ins | tol | uni | inter | diff | comp | incl | since | not | previous | rise | fall | event | always | if | else | whe | then | end | such | that | in | for | tru | fals | undefined | other | infinity }
