expr = { prefix* ~ primary ~ postfix* ~ (infix ~ prefix* ~ primary ~ postfix*)* }

infix = _{ add | sub | mul | pow | rem | and | or | xor | ge | le | neq | gt | lt | ini | fix | eq | div | uni | inter | incl | implies | since | iff | ins | diff | comp | tol }
add   =  { "+" }
sub   =  { "-" }
mul   =  { "*" }
div   =  { "/" }
rem   =  { "%" }
pow   =  { "^" }

and     = { "and" }
or      = { "or" }
xor     = { "xor" }
implies = { "implies" }
iff     = { "iff" }

ins = { "in" }
tol = { "tol" }

gt  = { ">" }
lt  = { "<" }
ge  = { ">=" }
le  = { "<=" }
neq = { "<>" }
eq  = { "=" }
fix = { ":=" }
ini = { "°=" }

uni   = { "union" }
inter = { "intersection" }
diff  = { "difference" }
comp  = { "complement" }
incl  = { "includes" }

since = { "since" }

prefix = _{ neg | plus | not | rise | fall | event | always | previous }
neg    =  { "-" }
plus   =  { "+" }

not = { "not" }

previous = { "previously" }
rise     = { "rising" }
fall     = { "falling" }
event    = { "eventually" }
always   = { "always" }

postfix = _{ fac | call }
fac     =  { "!" }
call    =  { "(" ~ expr? ~ ("," ~ expr)* ~ ")" }

primary = _{
    (num | bool | undefined | set | rng | intv | branch | when | forall | exists | aggregation | ident | "(" ~ expr ~ ")")
}

branch =  { if ~ expr ~ then ~ expr ~ (else ~ expr)? ~ end }
if     = _{ "if" }
else   = _{ "else" }

when      =  { whe ~ ((case ~ ("," ~ case)? ~ "," ~ otherwise) | (case ~ ",")* ~ case) ~ end }
whe       = _{ "when" }
case      =  { expr ~ then ~ expr }
otherwise =  { other ~ expr }

forall =  { fora ~ label ~ in ~ expr ~ such_that? ~ expr ~ end }
fora   = _{ "forall" }

exists =  { exi ~ label ~ in ~ expr ~ such_that? ~ end }
exi    = _{ "exists" }

such_that = _{ such ~ that ~ expr }

aggregation =  { aggregator ~ expr ~ (binding | ("," ~ expr)*) ~ end }
aggregator  = _{ (all | any | max | min | argmax | argmin | sup | inf | sum | prod | count | uni | inter | one | choose) }
all         =  { "all" }
any         =  { "any" }
one         =  { "one" }
max         =  { "max" }
min         =  { "min" }
sum         =  { "sum" }
prod        =  { "prod" }
argmax      =  { "argmax" }
argmin      =  { "argmin" }
sup         =  { "sup" }
inf         =  { "inf" }
count       =  { "count" }
choose      =  { "choose" }

then = _{ "then" }
end  = _{ "end" }
such = _{ "such" }
that = _{ "that" }
in   = _{ "in" }

set        =  { "{" ~ expr ~ (binding | ("," ~ expr)*) ~ "}" }
binding    =  { for ~ label ~ in ~ expr ~ such_that? }
for        = _{ "for" }
intv       =  { bracket ~ expr ~ "," ~ expr ~ bracket }
bracket    = _{ lbrkt | rbrkt }
rng        =  { "[[" ~ expr ~ "," ~ expr ~ "]]" }
lbrkt      =  { "[" }
rbrkt      =  { "]" }
bool       =  { tru | fals }
tru        =  { "true" }
fals       =  { "false" }
undefined  =  { "undefined" }
other      = _{ "otherwise" }
num        =  { real | infinity | int }
real       = @{ int ~ ("." ~ ASCII_DIGIT*)? ~ (^"e" ~ int)? }
int        =  { ASCII_DIGIT+ }
infinity   =  { "infinity" }
ident      = @{ (label ~ "::")* ~ label }
label      = @{ word+ }
word       = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHA | ASCII_DIGIT | "_")* }
WHITESPACE = _{ " " | "\t" | NEWLINE }
