package A
  @@
  System block
  @@
  part B
    @@
    Upper bound
    @@
    let x in real
    @@
    Offset
    @@
    let y in integer
  part
  requirement R1 
    on B
  is
    B::x in { s + 2 for s in [ 0, 1 ] }
  requirement
  requirement R2 
    on B
  is
    { s * 2 for s in integer such that s > 0 and s < B::y } includes { B::y }
  requirement
  requirement R3 
    on B
  is
    sum s * s for s in [[ 1, 10 ]] end > B::x
  requirement
  requirement R4 
    on B
  is
    all
      s < B::x
      for s in { 1, 2, 3 } such that s > B::y
    end
  requirement
  requirement R5 
    on B
  is
    any
      s = B::x
      for s in real
    end
  requirement
  requirement R6 
    on B
  is
    B::y in union { s, s + 1 } for s in [[ 0, 3 ]] end
  requirement
  requirement R7 
    on B
  is
    { t for t in { s ^ 2 for s in integer } such that t < 100 } includes { 1, 4 }
  requirement
  requirement R8 
    on B
  is
    sup s for s in ] 0, 1 [ end = 1 and inf s for s in [ 0, 1 ] end = 0
  requirement
  requirement R9 
    on B
  is
    count s for s in integer such that s > 0 and s < B::y end > 2
  requirement
  requirement R10 
    on B
  is
    count s for s in { true, false } end = 2
  requirement
  requirement R11 
    on B
  is
    argmax 0 - s ^ 2 for s in real end = { 0 }
  requirement
  requirement R12 
    on B
  is
    argmin (s - 3) ^ 2 for s in [[ 0, 10 ]] such that s > 5 end includes { 6 }
  requirement
  requirement R13 
    on B
  is
    choose t for t in argmax 0 - s ^ 2 for s in real end end = 0
  requirement
  requirement R14 
    on B
  is
    all
      s < B::x + B::y
      for s in real such that s > 10
    end
  requirement
  requirement R15 
    on B
  is
    any
      s > B::y and s < B::x
      for s in real
    end
  requirement
package
