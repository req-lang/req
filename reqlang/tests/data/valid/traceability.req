package A
  @@
  Top-level system
  @@
  part X
    @@
    Subsystem X1
    @@
    part X1
      @@
      Sub-subsystem X2
      @@
      part X2
        @@
        State flag
        @@
        let x in boolean
      part
    part
  part
  requirement R0 top 
    on X
  is
    @@
    very broad requirement on [[X]]
    @@
  requirement
  requirement R1 
    on X::X1
    refines R0
  is
    @@
    Some tests 1 on [[X::X1]]
    @@
  requirement
  requirement R2 
    on X::X1::X2
    refines R1
    refines R0
  is
    @@
    Some tests 2 on [[X::X1::X2]]
    @@
  requirement
  requirement R3 bottom 
    on X::X1::X2::x
    refines R1
    refines R2
  is
    @@
    Some tests on [[X::X1::X2::x]]
    @@
  requirement
package
