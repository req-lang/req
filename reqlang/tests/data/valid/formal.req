package A
  @@
  System block
  @@
  part B
    @@
    Power draw
    @@
    let x in real \ W \
    @@
    Status flag
    @@
    let y in boolean
  part
  @@
  Comment [[A::B::x]]
  @@
  # tag tag has a value #
  requirement R1 top bottom 
    on B::x
  is
    B::x = 0
  requirement
  requirement R2 top bottom 
    on B::y
  is
    B::y = true
  requirement
  requirement R3 top bottom 
    on B
  is
    @@
    Some tests [[B]]
    @@
  requirement
package
