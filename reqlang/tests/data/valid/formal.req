package A
  @@
  System block
  @@
  part B
    @@
    Power draw
    @@
    let x in real [ W ]
    @@
    Status flag
    @@
    let y in boolean
  part
  @@
  Comment {A::B::x}
  @@
  # tag tag has a value #
  requirement R1 
    on B
  is
    B::x = 0
  requirement
  requirement R2 
    on B
  is
    B::y = true
  requirement
package
