package A
  @@
  System block
  @@
  part B
    @@
    Power draw
    @@
    let x in real
    @@
    Sample count
    @@
    let y in integer
  part
  requirement R1 top bottom 
    on B::x
  is
    all
      B::x in real,
      B::y > 10
    end
  requirement
  requirement R2 top bottom 
    on B::y
  is
    any
      B::x in real,
      B::y > 10,
      B::x = 520
    end
  requirement
  requirement R3 top bottom 
    on B::x
  is
    sum
      10,
      20,
      B::x
    end
  requirement
  requirement R4 top bottom 
    on B::y
  is
    intersection
      { 10 },
      { 20 },
      { B::y }
    end
  requirement
  requirement R5 top bottom 
    on B::x
  is
    sup B::x, 10, 20 end > inf B::y, 30 end
  requirement
  requirement R6 top bottom 
    on B::y
  is
    count B::x, B::y, 30 end = 3
  requirement
  requirement R7 top bottom 
    on B::x
  is
    argmax B::x, 10, B::y end includes { 1, 2 }
  requirement
  requirement R8 top bottom 
    on B::x
  is
    argmin B::x, 10 end = { 2 }
  requirement
  requirement R9 top bottom 
    on B
  is
    @@
    Some tests [[B]]
    @@
  requirement
package
