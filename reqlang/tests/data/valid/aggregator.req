package A
  @@
  System block
  @@
  part B
    @@
    Power draw
    @@
    let x in real
    @@
    Sample count
    @@
    let y in integer
  part
  requirement R1 
    on B
  is
    all
      B::x in real,
      B::y > 10
    end
  requirement
  requirement R2 
    on B
  is
    any
      B::x in real,
      B::y > 10,
      B::x = 520
    end
  requirement
  requirement R3 
    on B
  is
    sum
      10,
      20,
      30
    end
  requirement
  requirement R4 
    on B
  is
    intersection
      { 10 },
      { 20 },
      { 30 }
    end
  requirement
  requirement R5 
    on B
  is
    sup B::x, 10, 20 end > inf B::y, 30 end
  requirement
  requirement R6 
    on B
  is
    count B::x, B::y, 30 end = 3
  requirement
  requirement R7 
    on B
  is
    argmax B::x, 10, B::y end includes { 1, 2 }
  requirement
  requirement R8 
    on B
  is
    argmin B::x, 10 end = { 2 }
  requirement
package
