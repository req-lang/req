package A
  @@
  System block
  @@
  part B
    @@
    Power draw
    @@
    let x in real
    @@
    Sample count
    @@
    let y in integer
  part
  requirement R1 
    on B
  is
    all
      B::x in real,
      B::y > 10
    end
  requirement
  requirement R2 
    on B
  is
    any
      B::x in real,
      B::y > 10,
      B::x = 520
    end
  requirement
  requirement R3 
    on B
  is
    sum
      10,
      20,
      30
    end
  requirement
  requirement R4 
    on B
  is
    intersection
      { 10 },
      { 20 },
      { 30 }
    end
  requirement
package
