package A
  @@
  System block
  @@
  part B
    @@
    Counter
    @@
    let ending in integer
  part
  requirement R1 
    on B
  is
    all
      notable < B::ending
      for notable in real such that notable > 0
    end
  requirement
  requirement R2 
    on B
  is
    all
      any
        trueValue > infinityLoop
        for trueValue in integer
      end
      for infinityLoop in integer such that infinityLoop > 0
    end
  requirement
  requirement R3 
    on B
  is
    any
      eventuallyDone > B::ending
      for eventuallyDone in integer
    end
  requirement
  requirement R4 
    on B
  is
    all
      always_ or not always_
      for always_ in boolean
    end
  requirement
package
